rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin(){return request.auth != null && request.auth.token.email == 'ahmedkabar.ak@gmail.com';}
  match /products/{id}{allow read: if true; allow create,update,delete: if isAdmin();}
  match /orders/{id}{allow create: if true; allow read,update,delete: if isAdmin();}
  match /users/{id}{allow read,write: if request.auth != null && request.auth.uid == id;}
 }
}